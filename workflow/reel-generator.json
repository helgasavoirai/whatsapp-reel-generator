    {"parameters":{"jsCode":"const input = $('Extract Twilio Fields').item.json;\nconst numMedia = parseInt(input.NumMedia || \"0\", 10);\nconst mediaType = (input.MediaContentType0 || \"\").toLowerCase();\nconst bodyText = (input.Body || \"\").trim();\n\nconst manualMode = [\"1\",\"2\",\"3\"].includes(bodyText) ? bodyText : null;\n\nlet detectedMode = \"pending\";\nif (mediaType.startsWith(\"video/\")) detectedMode = \"3\";\n\nconst isMedia = mediaType.startsWith(\"image/\") || mediaType.startsWith(\"video/\");\nconst isAudio = mediaType.startsWith(\"audio/\");\nconst isManualModeSelection = manualMode !== null && !isMedia && !isAudio;\n\nconst allMediaUrls = [input.MediaUrl0, input.MediaUrl1, input.MediaUrl2, input.MediaUrl3, input.MediaUrl4]\n  .slice(0, Math.max(numMedia, 1))\n  .filter(Boolean);\nconst mediaUrlsJoined = allMediaUrls.join(',');\n\nreturn { json: { ...input, detectedMode, manualMode, isMedia, isAudio, isManualModeSelection, mediaUrlsJoined } };"},"id":"93f650c4-221e-4302-8300-729035e90fde","name":"Auto Detection","type":"n8n-nodes-base.code","typeVersion":2,"position":[-688,400]},
    {"parameters":{"jsCode":"const current = $input.item.json;\nconst sessionRows = $('Google Sheets').all();\nconst existingSession = sessionRows.length > 0 ? sessionRows[0].json : null;\n\nconst hasExistingMedia = !!(existingSession && existingSession.MediaUrl);\nconst hasExistingAudio = !!(existingSession && existingSession.AudioUrl);\n\nlet mergedMediaUrl;\nif (current.isMedia) {\n  const stillAccumulating = hasExistingMedia && !hasExistingAudio;\n  const existingUrls = stillAccumulating ? existingSession.MediaUrl.split(',').filter(Boolean) : [];\n  const combined = [...existingUrls, ...current.mediaUrlsJoined.split(',').filter(Boolean)];\n  mergedMediaUrl = combined.slice(0, 5).join(',');\n} else {\n  mergedMediaUrl = existingSession ? existingSession.MediaUrl : undefined;\n}\nconst finalHasMedia = !!mergedMediaUrl;\n\nconst mergedAudioUrl = current.isAudio ? current.MediaUrl0 : (existingSession ? existingSession.AudioUrl : undefined);\nconst finalHasAudio = hasExistingAudio || current.isAudio;\n\nlet sessionCase;\nif (current.isManualModeSelection) {\n  sessionCase = \"MODE_SELECTED\";\n} else if (finalHasMedia && finalHasAudio) {\n  sessionCase = \"COMPLETE\";\n} else if (current.isMedia && !finalHasAudio) {\n  sessionCase = \"MEDIA_ONLY\";\n} else if (current.isAudio && !finalHasMedia) {\n  sessionCase = \"AUDIO_ONLY\";\n} else {\n  sessionCase = \"INVALID\";\n}\n\nconst priorModeWasVideo = existingSession && String(existingSession.DetectedMode) === '3';\nconst photoCount = mergedMediaUrl ? mergedMediaUrl.split(',').filter(Boolean).length : 0;\nlet mergedDetectedMode;\nlet autoDetected;\nif (current.manualMode) {\n  mergedDetectedMode = current.manualMode;\n  autoDetected = \"No\";\n} else if (current.detectedMode === \"3\") {\n  mergedDetectedMode = \"3\";\n  autoDetected = \"Yes\";\n} else if (priorModeWasVideo) {\n  mergedDetectedMode = \"3\";\n  autoDetected = \"Yes\";\n} else if (sessionCase === \"COMPLETE\") {\n  mergedDetectedMode = photoCount > 1 ? \"2\" : \"1\";\n  autoDetected = \"Yes\";\n} else if (existingSession && existingSession.DetectedMode) {\n  mergedDetectedMode = existingSession.DetectedMode;\n  autoDetected = existingSession.AutoDetected || \"\";\n} else {\n  mergedDetectedMode = \"pending\";\n  autoDetected = \"\";\n}\n\nreturn { json: { ...current, sessionCase, MediaUrl0: mergedMediaUrl, AudioUrl: mergedAudioUrl, detectedMode: mergedDetectedMode, autoDetected, photoCount } };"},"id":"260b0fd1-fe1b-43a1-92bd-9ced88ac5b6e","name":"Session Matching","type":"n8n-nodes-base.code","typeVersion":2,"position":[-464,400]},
